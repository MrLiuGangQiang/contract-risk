# ===== 服务配置 =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
# 初始超管（首次启动幂等创建，登录后必须改密；密码不满足策略时首次登录强制改密）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
# JWT 签名密钥（生产环境必须替换为强随机值，长度 >= 32）
JWT_SECRET=please-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# 加密主密钥（Fernet；生产环境必须替换）
FERNET_KEY=please-change-me

# ===== PostgreSQL =====
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=contract_risk
POSTGRES_USER=app_user
POSTGRES_PASSWORD=

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== 钉钉（也可由超管在配置页维护，此处为初始值）=====
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_REDIRECT_URI=http://localhost:5173/dingtalk/callback
