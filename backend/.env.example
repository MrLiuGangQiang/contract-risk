# ===== 服务配置 =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
# 初始超管（首次启动幂等创建，登录后必须改密；密码不满足策略时首次登录强制改密）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
# JWT 签名密钥（生产环境必须替换为强随机值，长度 >= 32）
JWT_SECRET=please-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# 加密主密钥（Fernet；生产环境必须替换，用 Fernet.generate_key() 生成）
FERNET_KEY=please-change-me

# ===== PostgreSQL（《02》4.6：推荐聚合格式，优先级最高）=====
# DATABASE_URL=postgresql+asyncpg://app_user:密码@127.0.0.1:5432/contract_risk
# 留空时按以下拆分项组装（兼容旧写法）：
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=contract_risk
POSTGRES_USER=app_user
POSTGRES_PASSWORD=
# 连接池（《09》第 2 节：上限按 worker 数 × 10~20 调整）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_ECHO=false

# ===== Redis（《02》4.6：推荐聚合格式，优先级最高）=====
# REDIS_URL=redis://:密码@127.0.0.1:6379/0
# 留空时按以下拆分项组装（兼容旧写法）：
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# 连接池
REDIS_MAX_CONNECTIONS=50

# ===== 钉钉（运行期由超管在系统配置页维护并加密存储于 sys_config，此处无需配置）=====
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_REDIRECT_URI=http://localhost:5173/dingtalk/callback
